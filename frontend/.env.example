# Front-end build-time configuration (Vite).
# Copy to `.env` (or `.env.local`) and adjust before `npm run build`.

# Origin of the Flask API. Leave empty when the API and the front-end are
# served from the same origin (the default on Render).
# For a separately hosted front-end set it to the API origin, e.g.
# VITE_API_URL=https://js2027-db.onrender.com
VITE_API_URL=
