# ─── Voters Database — Environment Variables ─────────────────────
# Copy this file to `.env` (or set these variables in your deployment
# platform) before going to production.

# Flask session secret — REQUIRED in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Admin credentials — REQUIRED in production (change from defaults).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Comma-separated list of allowed frontend origins.
# Example: https://voters-database.onrender.com
# Leave empty to allow all origins (development only).
ALLOWED_ORIGINS=

# Set to "true" to seed 40 demo records into an empty database (dev only).
SEED_DEMO=false

# Max photo size in bytes (default: 5MB).
MAX_PHOTO_BYTES=5242880

# Session lifetime in hours (default: 8).
SESSION_HOURS=8

# Server port (default: 8000).
PORT=8000
