# Flask Environment Variables Template
# Copy to .env for development
# Or set these in Render deployment environment

# Flask session secret - required in production
SECRET_KEY=your-very-secure-random-secret-key-change-this

# Admin credentials - change from defaults
ADMIN_USERNAME=admin
ADMIN_PASSWORD=js2027-123

# CORS settings - restrict in production
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Security settings
COOKIE_SECURE=true
SESSION_HOURS=8
MAX_PHOTO_BYTES=5242880

# Database seeding
SEED_DEMO=false

# Database file location (optional; defaults to backend/voters.db)
# VOTERS_DB=C:\path\to\backend\voters.db

# Server port
PORT=8000